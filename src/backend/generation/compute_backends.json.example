{
  "$comment": "Compute Backend Inventory — configurable sources of compute for generation. Managed via the Admin panel → Compute tab (CRUD over this file) and read at backend startup. Each backend declares which model_family capabilities it can run; the registry/router resolve the enabled backend per request. `type` is 'comfyui' (any headless/desktop ComfyUI server reachable by base_url) or 'runpod' (serverless container with an ephemeral ComfyUI — submit via the RunPod client). Secrets (RunPod endpoint IDs, API keys) stay in .env; this file only references them by name. COPY THIS FILE TO `compute_backends.json` (gitignored) and set the real per-server addresses there — never commit private IPs/hosts.",
  "backends": [
    {
      "id": "ai-kvm2-comfyui",
      "name": "ai-kvm2 ComfyUI (local)",
      "type": "comfyui",
      "base_url": "http://localhost:8188",
      "enabled": true,
      "model_families": ["wan2.2", "sdxl", "flux", "flux2", "krea2", "utility"],
      "notes": "Default local server. systemd comfyui, always_on."
    },
    {
      "id": "windows-pc-comfyui",
      "name": "Windows-PC ComfyUI",
      "type": "comfyui",
      "base_url": "http://windows-pc.test.invalid:8188",
      "enabled": false,
      "model_families": ["minimax_h3"],
      "notes": "User's Windows PC (ComfyUI portable) running local MiniMax-H3. Set the real host here via the Admin panel, or via COMPUTE_NODE_2_HOST in .env for the fresh-install fallback (never commit it)."
    },
    {
      "id": "runpod-cloud",
      "name": "RunPod serverless cloud",
      "type": "runpod",
      "base_url": "",
      "enabled": true,
      "model_families": ["wan2.2", "ltx", "minimax_h3", "qwen_image_edit", "i2i_edit_model"],
      "notes": "Serverless containers, each an ephemeral ComfyUI. Endpoint IDs in .env."
    }
  ]
}

# Supabase Auth Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Supabase Project URL
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase Keys (from Project Settings → API)
SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_KEY=eyJhbG...

# JWT Secret (from Project Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=your-jwt-secret

# MinIO Object Storage
# URL to MinIO server (default: http://localhost:9000)
MINIO_ENDPOINT=http://localhost:9000
# MinIO access credentials (create via MinIO Console or mc admin)
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
# MinIO data directory (used to prevent accidental cleanup of MinIO data files)
MINIO_DATA_DIR=/home/flip/minio-data

# Public site URL — used for Open Graph share links in /share/{id}
SITE_URL=https://your-domain.com

# Stripe Payment Integration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook secret - get from Stripe CLI or Dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Frontend URL for Stripe redirects
FRONTEND_URL=http://localhost:5174

# Debug mode (0 or 1)
OELALA_DEBUG=0

# Guardian LLM Proxy - VRAM Management
# Unloads LLM before ComfyUI generation to free all VRAM for media generation.
# Guardian auto-reloads the model on the next inference request (~30s warm-up).
GUARDIAN_BASE_URL=http://guardian.test.invalid:11434
GUARDIAN_API_KEY=your-guardian-api-key

# RunPod Serverless
# Primary endpoint used by default for cloud jobs.
RUNPOD_API_KEY=rpa_xxx
RUNPOD_ENDPOINT_ID=your-primary-endpoint-id
# Optional ordered fallback list. The backend will prefer healthy endpoints and
# skip endpoints that currently report throttled or unhealthy health.
RUNPOD_ENDPOINT_IDS=your-primary-endpoint-id,your-secondary-endpoint-id
# Optional comma-separated directories to search for RunPod cached-model files
# before the worker falls back to live Hugging Face downloads.
RUNPOD_CACHED_MODEL_DIRS=/runpod-volume/huggingface-cache/hub,/root/.cache/huggingface/hub
# Optional S3-compatible credentials for uploading selected LoRAs/private assets
# to the detached RunPod LoRA Network Volume. This is a separate S3 API key,
# not the normal RUNPOD_API_KEY.
RUNPOD_S3_ACCESS_KEY_ID=user_xxx
RUNPOD_S3_SECRET_ACCESS_KEY=rps_xxx
RUNPOD_LORA_VOLUME_ID=ochebt0xbq
RUNPOD_LORA_VOLUME_DATACENTER=EU-CZ-1
RUNPOD_LORA_S3_ENDPOINT=https://s3api-eu-cz-1.runpod.io

# MiniMax-H3 video+audio endpoint (t2v / i2v, 80GB+ GPUs)
# Create the template + endpoint on RunPod first, then fill in the IDs
# (see docs/RUNPOD_NEW_ENDPOINT_CHECKLIST.md).
RUNPOD_MINIMAX_H3_ENDPOINT_ID=your-minimax-h3-endpoint-id
RUNPOD_MINIMAX_H3_TEMPLATE_ID=your-minimax-h3-template-id

# ── Compute Nodes (fresh-install fallback inventory) ──────────────────
# The Admin panel → Compute (compute_backends.json) is the source of truth for
# which compute servers exist and which model families each one runs. The
# COMPUTE_NODE_n_* groups below are only the built-in fallback used on a fresh
# install before the first Admin save; keep them in sync with the servers you
# actually run. Each group declares one node:
#   TYPE=comfy|runpod — 'comfy': a hosted/desktop ComfyUI reachable by
#                       HOST:PORT; 'runpod': a serverless RunPod container
#                       (endpoint IDs stay under RUNPOD_* above, no HOST).
#   HOST / PORT       — address of a 'comfy' node (PORT optional, default 8188).
#   NAME              — display name for the node.
#   MODEL_FAMILIES    — comma-separated model families this node can run.
# Node numbers must be contiguous (COMPUTE_NODE_1..N); the scan stops at the
# first gap. Never commit real private addresses — use placeholders here.
COMPUTE_NODE_1_TYPE=comfy
COMPUTE_NODE_1_HOST=localhost
COMPUTE_NODE_1_PORT=8188
COMPUTE_NODE_1_NAME=ai-kvm2 ComfyUI (local)
COMPUTE_NODE_1_MODEL_FAMILIES=wan2.2,sdxl,flux,flux2,krea2,utility

COMPUTE_NODE_2_TYPE=comfy
COMPUTE_NODE_2_HOST=windows-pc.test.invalid
COMPUTE_NODE_2_NAME=Windows-PC ComfyUI
COMPUTE_NODE_2_MODEL_FAMILIES=minimax_h3

COMPUTE_NODE_3_TYPE=runpod
COMPUTE_NODE_3_NAME=RunPod serverless
COMPUTE_NODE_3_MODEL_FAMILIES=wan2.2,ltx,minimax_h3,qwen_image_edit,i2i_edit_model

# SSH host/alias of the remote ComfyUI server used by scripts/monitor_h3.sh
# (e.g. the second ComfyUI node above). Set the real alias in .env.
H3_SSH_HOST=teams-host.test.invalid

# Google OAuth (configured in Supabase dashboard, not needed here)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# ── Sentry Error Tracking ──────────────────────────────────────────
# Backend DSN (from Sentry project settings)
SENTRY_DSN=https://xxxx@o12345.ingest.sentry.io/12345
SENTRY_ENVIRONMENT=production
# Sample rates (0.0–1.0): lower = less performance overhead
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Frontend DSN (set in Vite env as VITE_ prefix)
VITE_SENTRY_DSN=https://xxxx@o12345.ingest.sentry.io/12345
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

# Source map upload (CI/build only)
# SENTRY_AUTH_TOKEN=sntrys_xxxx
# SENTRY_ORG=oelala
# SENTRY_PROJECT=oelala-frontend

# ── Email Notifications ───────────────────────────────────────────
# Option A: Resend (recommended, free tier 100 emails/day)
RESEND_API_KEY=re_xxxx

# Option B: SMTP (alternative)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password

# From address for notification emails
EMAIL_FROM=Oelala <noreply@oelala.xyz>

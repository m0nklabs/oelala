{
  "name": "@oelala/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for the Oelala AI generation API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["oelala", "ai", "video-generation", "image-generation", "sdk", "wan2.2"],
  "author": "Oelala <dev@oelala.xyz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oelala-xyz/oelala-js"
  },
  "homepage": "https://oelala.xyz",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}

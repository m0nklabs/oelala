  "components": {
    "schemas": {
      "CreditsResponse": {
        "properties": {
          "balance": {
            "type": "integer",
            "title": "Balance",
            "description": "Current available credits"
          },
          "lifetime_purchased": {
            "type": "integer",
            "title": "Lifetime Purchased",
            "description": "Total credits ever purchased"
          },
          "lifetime_used": {
            "type": "integer",
            "title": "Lifetime Used",
            "description": "Total credits ever used"
          }
        },
        "type": "object",
        "required": [
          "balance",
          "lifetime_purchased",
          "lifetime_used"
        ],
        "title": "CreditsResponse",
        "description": "Credits balance response."
      },
      "GenerateRequest": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text-to-image",
              "text-to-video",
              "image-to-video"
            ],
            "title": "Type",
            "description": "Type of generation"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "title": "Prompt",
            "description": "Text prompt for generation"
          },
          "negative_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Negative Prompt",
            "description": "Negative prompt (what to avoid)"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2048.0,
                "minimum": 256.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "Output width",
            "default": 1024
          },
          "height": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2048.0,
                "minimum": 256.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "Output height",
            "default": 1024
          },
          "steps": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps",
            "description": "Inference steps",
            "default": 20
          },
          "cfg": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 20.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cfg",
            "description": "CFG scale",
            "default": 7.5
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "Random seed (-1 for random)",
            "default": -1
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 30.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds",
            "description": "Video duration in seconds (for video generation)"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url",
            "description": "URL of source image (for I2V)"
          }
        },
        "type": "object",
        "required": [
          "type",
          "prompt"
        ],
        "title": "GenerateRequest",
        "description": "Request body for generation endpoint."
      },
      "GenerateResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "Unique job identifier"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Job status (queued, running, completed, failed)"
          },
          "credits_used": {
            "type": "integer",
            "title": "Credits Used",
            "description": "Credits deducted for this generation"
          },
          "estimated_time_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Time Seconds",
            "description": "Estimated completion time in seconds"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "credits_used"
        ],
        "title": "GenerateResponse",
        "description": "Response from generation endpoint."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobStatus": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "Job identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "title": "Status",
            "description": "Current job status"
          },
          "progress": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress",
            "description": "Progress percentage"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "Job creation timestamp (ISO 8601)"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At",
            "description": "Job completion timestamp"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Error message if failed"
          },
          "result_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Url",
            "description": "URL to download result (when completed)"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata",
            "description": "Additional job metadata"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "created_at"
        ],
        "title": "JobStatus",
        "description": "Job status response."
      },
      "TestWebhookResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "status_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Code"
          },
          "response_time_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Time Ms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "TestWebhookResponse",
        "description": "Response model for test webhook."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",

[Unit]
Description=ComfyUI AI Image/Video Generation Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=flip
WorkingDirectory=/home/flip/oelala/ComfyUI
ExecStart=/home/flip/venvs/gpu/bin/python main.py --listen 0.0.0.0 --port 8188 --enable-manager
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PATH=/home/flip/venvs/gpu/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=0,1

[Install]
WantedBy=multi-user.target
